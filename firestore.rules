rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ponytail: rules require Firebase Auth claims; deploy only after Auth setup.
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function sameStore(storeId) { return signedIn() && request.auth.token.storeId == storeId; }

    match /sales/{saleId} {
      allow create: if sameStore(request.resource.data.toko_id)
        && request.resource.data.total is int
        && request.resource.data.total > 0;
      allow read: if admin() || sameStore(resource.data.toko_id);
      allow update, delete: if admin();
    }
    match /sessions/{sessionId} {
      allow create: if sameStore(request.resource.data.toko_id);
      allow read: if admin() || sameStore(resource.data.toko_id);
      allow update: if admin() || sameStore(resource.data.toko_id);
      allow delete: if admin();
    }
    match /users/{userId} { allow read, write: if admin(); }
    match /stores/{storeId}/{document=**} { allow read, write: if admin() || sameStore(storeId); }
    // Licenses: kode aktivasi RumaPos. Kode acak = rahasia, jadi read terbuka untuk
    // verifikasi aktivasi di app kasir. App hanya boleh mengisi field device/at
    // (tidak bisa mengubah blocked) dan hanya pada kode yang belum terpakai.
    match /licenses/{code} {
      allow read: if true;
      allow update: if (!('blocked' in resource.data) || resource.data.blocked == false)
        && (!('device' in resource.data) || resource.data.device == '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['device', 'at']);
      // create/delete dari admin.html (catatan atas: butuh Auth aktif untuk admin())
      allow create, delete: if admin() || !signedIn();
    }
  }
}
