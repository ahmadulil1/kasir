rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ponytail: rules require Firebase Auth claims; deploy only after Auth setup.
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function sameStore(storeId) { return signedIn() && request.auth.token.storeId == storeId; }

    match /sales/{saleId} {
      allow create: if sameStore(request.resource.data.toko_id)
        && request.resource.data.total is int
        && request.resource.data.total > 0;
      allow read: if admin() || sameStore(resource.data.toko_id);
      allow update, delete: if admin();
    }
    match /sessions/{sessionId} {
      allow create: if sameStore(request.resource.data.toko_id);
      allow read: if admin() || sameStore(resource.data.toko_id);
      allow update: if admin() || sameStore(resource.data.toko_id);
      allow delete: if admin();
    }
    match /users/{userId} { allow read, write: if admin(); }
    match /stores/{storeId}/{document=**} { allow read, write: if admin() || sameStore(storeId); }
  }
}
