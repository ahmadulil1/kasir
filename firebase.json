{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", ".firebaserc", "test.js", ".git/**", ".idea/**", "node_modules/**", "sw.js"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/", "destination": "/landing.html" },
      { "source": "/app", "destination": "/index.html" },
      { "source": "/admin", "destination": "/admin.html" }
    ]
  }
}
